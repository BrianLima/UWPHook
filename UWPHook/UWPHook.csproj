<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>UWPHook</RootNamespace>
		<AssemblyName>UWPHook</AssemblyName>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Resources\hook2.ico</ApplicationIcon>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Single-file publish (dotnet publish -r win-x64 | win-arm64). Compression requires
	     a self-contained app, and self-contained requires a RID, so this only applies
	     when a RuntimeIdentifier is given. -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- The Windows integration tests drive internal types such as ScriptManager. -->
		<InternalsVisibleTo Include="UWPHook.Windows.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\UWPHook.Core\UWPHook.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\KnownApps.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\WhiteTransparent.png" />
		<Resource Include="Resources\BlackTransparent.png" />
		<Resource Include="Resources\briano.png" />
		<Resource Include="Resources\hook2.ico" />
		<Resource Include="Resources\square.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignColors" />
		<PackageReference Include="MaterialDesignThemes" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.File" />
		<!-- WMI process lookup in AppManager (it used to come in through the PowerShell SDK). -->
		<PackageReference Include="System.Management" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
</Project>
