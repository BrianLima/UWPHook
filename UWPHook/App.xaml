<!-- WPF's built-in Fluent theme, light or dark as Windows is set (Mica only on Windows 11).
     ThemeMode is experimental in .NET 9/10 (WPF0001); it is set here only. -->
<Application x:Class="UWPHook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UWPHook"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Segoe Fluent Icons ships with Windows 11; Windows 10 has the same code points in Segoe MDL2 Assets. -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- A glyph from IconFont, e.g. <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;"/>. -->
            <Style x:Key="IconGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- The band behind the white UWPHook logo: the user's accent, dark enough for white text in both themes. -->
            <Style x:Key="HeaderBand" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorDark1BrushKey}}"/>
                <Setter Property="Height" Value="80"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
